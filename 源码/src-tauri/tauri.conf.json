{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "数字炸弹",
  "version": "1.0.0",
  "identifier": "com.numberbomb.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "数字炸弹",
        "width": 460,
        "height": 780,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
